# Server environment configuration (example)
# Copy this file to server/.env and fill values. NEVER commit server/.env.

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL_NAME=models/gemini-1.5-flash-latest

# Flask / JWT
SECRET_KEY=
JWT_SECRET_KEY=

# Email (Gmail SMTP defaults shown)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
EMAIL_USER=
EMAIL_PASS=

# MongoDB
# e.g. mongodb+srv://user:pass@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=
MONGO_DB=resumetric
MONGO_TIMEOUT_MS=10000
# Set to true only for local dev if you must bypass TLS verification
MONGO_TLS_ALLOW_INVALID=false

# Google OAuth (if used)
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/callback
